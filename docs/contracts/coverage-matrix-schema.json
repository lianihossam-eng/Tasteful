{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasteful.dev/contracts/coverage-matrix-schema.json",
  "title": "Tasteful coverage matrix v1",
  "version": 1,
  "owner": "workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_id", "platforms", "screens"],
  "properties": {
    "brief_id": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen", "states", "breakpoints", "decision", "rationale"],
        "properties": {
          "screen": { "type": "string", "minLength": 1 },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "breakpoints": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "decision": { "enum": ["in", "out"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
